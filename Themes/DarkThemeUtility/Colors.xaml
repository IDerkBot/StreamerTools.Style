<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BackgrounPrimaryColor">#1E1E1E</Color>
    <Color x:Key="BackgrounSecondaryColor">#1E1E1E</Color>
    <Color x:Key="PrimaryColor">#353536</Color>
    <Color x:Key="Hover_PrimaryColor">#3a3a3a</Color>
    <Color x:Key="Pressed_PrimaryColor">#373737</Color>
    <Color x:Key="SecondaryColor">#252526</Color>
    <Color x:Key="Hover_SecondaryColor">#2a2a2a</Color>
    <Color x:Key="Pressed_SecondaryColor">#272727</Color>
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="ScrollViewerBackgroundColor">#141414</Color>
    <Color x:Key="ScrollBarTrackColor">#5A5A5E</Color>
    <Color x:Key="ScrollBarThumbColor">#5A5A5E</Color>
    <Color x:Key="Hover_ScrollBarThumbColor">#74747A</Color>
    <Color x:Key="Pressed_ScrollBarThumbColor">#8A8A92</Color>

    <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="{StaticResource BackgrounPrimaryColor}" />
    <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="{StaticResource BackgrounSecondaryColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="Hover_PrimaryBrush" Color="{StaticResource Hover_PrimaryColor}" />
    <SolidColorBrush x:Key="Pressed_PrimaryBrush" Color="{StaticResource Pressed_PrimaryColor}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="Hover_SecondaryBrush" Color="{StaticResource Hover_SecondaryColor}" />
    <SolidColorBrush x:Key="Pressed_SecondaryBrush" Color="{StaticResource Pressed_SecondaryColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="ScrollViewerBackgroundBrush" Color="{StaticResource ScrollViewerBackgroundColor}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{StaticResource ScrollBarTrackColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{StaticResource ScrollBarThumbColor}" />
    <SolidColorBrush x:Key="Hover_ScrollBarThumbBrush" Color="{StaticResource Hover_ScrollBarThumbColor}" />
    <SolidColorBrush x:Key="Pressed_ScrollBarThumbBrush" Color="{StaticResource Pressed_ScrollBarThumbColor}" />
</ResourceDictionary>