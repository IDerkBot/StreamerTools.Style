<UserControl
    x:Class="StreamerTools.Style.Controls.Icon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Name="Root"
    MinWidth="15"
    MinHeight="15"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    d:Background="White"
    d:DesignHeight="40"
    d:DesignWidth="40"
    Background="Transparent"
    mc:Ignorable="d">
    <Path
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Data="{Binding ElementName=Root, Path=Image}"
        Fill="{Binding ElementName=Root, Path=Fill}"
        Stretch="Uniform"
        Stroke="{Binding ElementName=Root, Path=StrokeColor}"
        StrokeThickness="{Binding ElementName=Root, Path=Stroke}" />
</UserControl>
